# Copy this file to db.properties (same folder) and fill in your own
# MySQL connection details. db.properties is git-ignored on purpose so
# your password is never committed.
#
# Create the schema first using MySQL Workbench or the command line:
#   CREATE DATABASE sunrise_dental;
#   (then run db/schema.sql against it)

db.url=jdbc:mysql://localhost:3306/sunrise_dental?useSSL=false&serverTimezone=UTC
db.username=root
db.password=your_mysql_password_here
